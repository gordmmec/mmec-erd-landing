{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erd-mmec-ca",
  "main": "./src/worker.js",
  "compatibility_date": "2026-04-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "EMAIL_BUCKET", "bucket_name": "erd-email" }
  ],
  "observability": {
    "enabled": true
  }
}
